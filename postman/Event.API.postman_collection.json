    {
      "name": "07 Payments",
      "item": [
        {
          "name": "Create Payment Intent",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is expected', function () { pm.expect([200]).to.include(pm.response.code); });",
                  "try { const json = pm.response.json(); if (json.paymentIntentId) pm.collectionVariables.set('paymentIntentId', json.paymentIntentId); } catch (e) {}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {

              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"returnUrl\": \"https://eventbox.test/checkout/return\",\n  \"cancelUrl\": \"https://eventbox.test/checkout/cancel\",\n  \"orderAccessCode\": \"{{orderAccessCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/payments/intents"
          },
          "response": []
        },
        {

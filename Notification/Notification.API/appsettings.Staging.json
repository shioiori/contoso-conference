{
  "Serilog": {
    "LogGroup": "/eventbox/notification-api/Staging",
    "Region": "ap-southeast-2",
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Using": [ "Serilog.Sinks.Console", "AWS.Logger.SeriLog" ],
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "AWSSeriLog"
      }
    ]
  },
  "Smtp": {
    "Host": "__SMTP_HOST__",
    "Port": 587,
    "Username": "__SMTP_USER__",
    "Password": "__SMTP_PASSWORD__",
    "FromAddress": "noreply@eventbox.com",
    "FromName": "Eventbox"
  },
  "Messaging": {
    "Provider": "Aws"
  },
  "Aws": {
    "Region": "ap-southeast-2",
    "Queues": {
      "Notification": "https://sqs.ap-southeast-2.amazonaws.com/450456826271/eventbox-notification-queue",
      "NotificationDlq": "https://sqs.ap-southeast-2.amazonaws.com/450456826271/eventbox-notification-dlq"
    }
  }
}


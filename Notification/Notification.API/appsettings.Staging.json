{
  "Serilog": {
    "LogGroup": "/eventbox/notification-api/Staging",
    "Region": "ap-southeast-2",
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Using": [ "Serilog.Sinks.Console", "AWS.Logger.SeriLog" ],
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "AWSSeriLog"
      }
    ]
  },
  "Smtp": {
    "Host": "__SMTP_HOST__",
    "Port": 587,
    "Username": "__SMTP_USER__",
    "Password": "__SMTP_PASSWORD__",
    "FromAddress": "noreply@eventbox.com",
    "FromName": "Eventbox"
  },
  "RabbitMQ": {
    "Host": "__RABBITMQ_HOST__",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "__RABBITMQ_USER__",
    "Password": "__RABBITMQ_PASSWORD__"
  }
}

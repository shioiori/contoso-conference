  <data name="OrderConfirmedBody" xml:space="preserve">
    <value><![CDATA[<!DOCTYPE html><html><body style="font-family:Arial,sans-serif;color:#333;max-width:600px;margin:0 auto;padding:20px"><h2 style="color:#4f46e5">Order Confirmed!</h2><p>Hi {0},</p><p>Your order has been confirmed. Use the access code below to look up your tickets:</p><div style="background:#f5f5f5;border-radius:8px;padding:24px;text-align:center;margin:24px 0"><p style="margin:0 0 8px;color:#666;font-size:14px">ACCESS CODE</p><p style="margin:0;font-size:32px;font-weight:bold;letter-spacing:6px;color:#4f46e5">{1}</p></div><table style="width:100%;border-collapse:collapse;margin-top:24px"><thead><tr style="background:#4f46e5;color:white"><th style="padding:10px 16px;text-align:left">Ticket</th><th style="padding:10px 16px;text-align:center">Qty</th><th style="padding:10px 16px;text-align:right">Price</th></tr></thead><tbody>{2}</tbody></table><h3 style="margin-top:32px;color:#111">Your Tickets</h3>{3}<p style="margin-top:32px;color:#666;font-size:13px">Order ID: {4}</p><p style="color:#666;font-size:13px">If you have any questions, please contact our support team.</p></body></html>]]></value>

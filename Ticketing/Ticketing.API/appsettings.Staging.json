{
  "Serilog": {
    "LogGroup": "/eventbox/ticketing-api/Staging",
    "Region": "ap-southeast-2",
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Using": [ "Serilog.Sinks.Console", "AWS.Logger.SeriLog" ],
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "AWSSeriLog"
      }
    ]
  },
  "ConnectionStrings": {
    "Database": "Host=__STAGING_DB_HOST__;Port=5432;Database=TicketingDb;Username=__DB_USER__;Password=__DB_PASSWORD__"
  },
  "Messaging": {
    "Provider": "Aws"
  },
  "Aws": {
    "Region": "ap-southeast-2",
    "Topics": {
      "Ticketing": "arn:aws:sns:ap-southeast-2:450456826271:eventbox-ticketing"
    },
    "Queues": {
      "Ticketing": "https://sqs.ap-southeast-2.amazonaws.com/450456826271/eventbox-ticketing-queue",
      "TicketingDlq": "https://sqs.ap-southeast-2.amazonaws.com/450456826271/eventbox-ticketing-dlq",
      "TicketingExpiration": "https://sqs.ap-southeast-2.amazonaws.com/450456826271/eventbox-ticketing-expiration-queue",
      "TicketingExpirationDlq": "https://sqs.ap-southeast-2.amazonaws.com/450456826271/eventbox-ticketing-expiration-dlq"
    }
  }
}


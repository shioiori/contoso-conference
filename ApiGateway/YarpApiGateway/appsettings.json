{
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/auth/{**catch-all}"
          }
        ]
      },
      "events": {
        "ClusterId": "event",
        "Match": {
          "Path": "/api/events/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/public/events/{**catch-all}"
          }
        ]
      },
      "organizer": {
        "ClusterId": "event",
        "Match": {
          "Path": "/api/organizations/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/organizations/{**catch-all}"
          }
        ]
      },
      "orders-create": {
        "ClusterId": "ticketing",
        "Match": {
          "Path": "/api/orders/{eventId}",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          {
            "PathPattern": "/api/public/orders/{eventId}"
          }
        ]
      },
      "orders-lookup": {
        "ClusterId": "ticketing",
        "Match": {
          "Path": "/api/orders/lookup",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          {
            "PathPattern": "/api/public/orders/lookup"
          }
        ]
      },
      "orders-start-payment": {
        "ClusterId": "ticketing",
        "Match": {
          "Path": "/api/orders/{orderId}/start-payment",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          {
            "PathPattern": "/api/public/orders/{orderId}/start-payment"
          }
        ]
      },
      "orders": {
        "ClusterId": "ticketing",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/customer/orders/{**catch-all}"
          }
        ]
      },
      "ticket-availability": {
        "ClusterId": "ticketing",
        "Match": {
          "Path": "/api/tickets/{eventId}/availability"
        },
        "Transforms": [
          {
            "PathPattern": "/api/public/tickets/{eventId}/availability"
          }
        ]
      },
      "check-ins": {
        "ClusterId": "ticketing",
        "Match": {
          "Path": "/api/check-ins/{eventId}",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          {
            "PathPattern": "/api/organizer/check-ins/{eventId}"
          }
        ]
      },
      "payments": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/payments/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "auth-api": {
            "Address": "http://auth.api:8080"
          }
        }
      },
      "event": {
        "Destinations": {
          "event-api": {
            "Address": "http://event.api:8080"
          }
        }
      },
      "ticketing": {
        "Destinations": {
          "ticketing-api": {
            "Address": "http://ticketing.api:8080"
          }
        }
      },
      "payment": {
        "Destinations": {
          "payment-api": {
            "Address": "http://payment.api:8080"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}

{
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/auth/{**catch-all}"
          }
        ]
      },
      "events": {
        "ClusterId": "event",
        "Match": {
          "Path": "/events/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/public/events/{**catch-all}"
          }
        ]
      },
      "organizer": {
        "ClusterId": "event",
        "Match": {
          "Path": "/organizations/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/organizations/{**catch-all}"
          }
        ]
      },
      "ticketing-public": {
        "ClusterId": "ticketing",
        "Match": {
          "Path": "/ticketing/public/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/public/{**catch-all}"
          }
        ]
      },
      "ticketing-customer": {
        "ClusterId": "ticketing",
        "Match": {
          "Path": "/ticketing/customer/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/customer/{**catch-all}"
          }
        ]
      },
      "ticketing-events": {
        "ClusterId": "ticketing",
        "Match": {
          "Path": "/ticketing/events/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/events/{**catch-all}"
          }
        ]
      },
      "payments": {
        "ClusterId": "payment",
        "Match": {
          "Path": "/payments/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/payments/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "auth-api": {
            "Address": "http://auth.api:8080"
          }
        }
      },
      "event": {
        "Destinations": {
          "event-api": {
            "Address": "http://event.api:8080"
          }
        }
      },
      "ticketing": {
        "Destinations": {
          "ticketing-api": {
            "Address": "http://ticketing.api:8080"
          }
        }
      },
      "payment": {
        "Destinations": {
          "payment-api": {
            "Address": "http://payment.api:8080"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
